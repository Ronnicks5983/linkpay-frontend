# LinkPay Frontend - Production Environment
# Copy this to .env and set NEXT_PUBLIC_API_BASE_URL to your deployed backend

# Backend API URL (required for login/register/dashboard to work in production)
# Example: https://api.linkpay.vendas.co.ke or https://linkpay-backend.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.example.com
